#!/usr/bin/env sh

msg_file="$1"
msg=$(head -n 1 "$msg_file")

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,}$'

if echo "$msg" | grep -Eq "$pattern"; then
  exit 0
fi

echo ""
echo "Invalid commit message format."
echo "Use Conventional Commits:"
echo "  type(scope): short description"
echo ""
echo "Examples:"
echo "  feat(auth): add after-login redirect"
echo "  fix(orders): validate status transition"
echo "  docs(specs): update todo and progress log"
echo ""
exit 1
