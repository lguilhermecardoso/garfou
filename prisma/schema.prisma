// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH (Auth.js required tables)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  accounts             Account[]
  sessions             Session[]
  restaurants          UserRestaurant[]
  orders               Order[]             @relation("WaiterOrders")
  tabsOpened           Tab[]               @relation("TabsOpened")
  tabsClosed           Tab[]               @relation("TabsClosed")
  cashRegistersOpened  CashRegister[]      @relation("CashRegisterOpenedBy")
  cashRegistersClosed  CashRegister[]      @relation("CashRegisterClosedBy")
  cashTransactions     CashTransaction[]   @relation("CashTransactionUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// MULTITENANCY
// ─────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  WAITER
  KITCHEN
  CASHIER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
}

model Restaurant {
  id      String @id @default(cuid())
  name    String
  slug    String @unique
  logo    String?
  phone   String?
  address String?
  city    String?
  state   String?

  // Stripe
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  subscriptionStatus     SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?

  // Operations
  isOpen    Boolean @default(false)
  settings  Json    @default("{}")

  // Relations
  members         UserRestaurant[]
  categories      Category[]
  products        Product[]
  productAddons   ProductAddon[]
  modifierGroups  ModifierGroup[]
  modifierOptions ModifierOption[]
  splitFlavors    ProductSplitFlavor[]
  tables          Table[]
  tabs            Tab[]
  orders          Order[]
  customers       Customer[]
  inventoryItems  InventoryItem[]
  inventoryMoves  InventoryMovement[]
  financeEntries  FinanceEntry[]
  operatingHours  OperatingHours[]
  deliveryZones   DeliveryZone[]
  coupons         Coupon[]
  npsResponses    NpsResponse[]
  cashRegisters   CashRegister[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("restaurants")
}

model UserRestaurant {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String
  role         UserRole @default(WAITER)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, restaurantId])
  @@map("user_restaurants")
}

// ─────────────────────────────────────────────
// MENU
// ─────────────────────────────────────────────

model Category {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  image        String?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([restaurantId, deletedAt])
  @@map("categories")
}

model Product {
  id              String   @id @default(cuid())
  restaurantId    String
  categoryId      String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  image           String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  isInternalOnly  Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  allowCustomization Boolean @default(false)
  allowSplit      Boolean  @default(false)
  maxSplits       Int      @default(2)
  splitPriceRule  SplitPriceRule @default(HIGHEST)
  preparationTime Int?     // minutes
  costPrice       Decimal? @db.Decimal(10, 2)

  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        Category            @relation(fields: [categoryId], references: [id])
  addons          ProductAddon[]
  modifierGroups  ModifierGroup[]
  splitSources    ProductSplitFlavor[] @relation("SplitSource")
  splitTargets    ProductSplitFlavor[] @relation("SplitTarget")
  orderItems      OrderItem[]
  orderItemSplits OrderItemSplit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([restaurantId, isActive, deletedAt])
  @@index([restaurantId, categoryId])
  @@map("products")
}

model ProductAddon {
  id           String  @id @default(cuid())
  restaurantId String
  productId    String
  name         String
  price        Decimal @db.Decimal(10, 2) @default(0)
  isRequired   Boolean @default(false)
  maxQuantity  Int     @default(1)

  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemAddons OrderItemAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_addons")
}

enum ModifierGroupType {
  INGREDIENT
  ADDON
  REQUIRED_CHOICE
  REQUIRED_MULTI
}

enum SplitPriceRule {
  HIGHEST
  AVERAGE
  SUM
}

model ModifierGroup {
  id            String            @id @default(cuid())
  restaurantId  String
  productId      String
  name          String
  type          ModifierGroupType
  minSelections Int               @default(0)
  maxSelections Int               @default(1)
  sortOrder     Int               @default(0)

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    ModifierOption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([restaurantId, productId, deletedAt])
  @@map("modifier_groups")
}

model ModifierOption {
  id           String   @id @default(cuid())
  restaurantId String
  groupId       String
  name         String
  price        Decimal  @db.Decimal(10, 2) @default(0)
  isDefault    Boolean  @default(false)
  isAvailable  Boolean  @default(true)
  sortOrder    Int      @default(0)

  restaurant      Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  group           ModifierGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderSelections OrderItemSelectedOption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([restaurantId, groupId, deletedAt])
  @@map("modifier_options")
}

model ProductSplitFlavor {
  id              String  @id @default(cuid())
  restaurantId    String
  sourceProductId String
  flavorProductId String
  sortOrder       Int     @default(0)
  isAvailable     Boolean @default(true)

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sourceProduct Product    @relation("SplitSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  flavorProduct Product    @relation("SplitTarget", fields: [flavorProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceProductId, flavorProductId])
  @@index([restaurantId, sourceProductId])
  @@map("product_split_flavors")
}

// ─────────────────────────────────────────────
// TABLES & TABS (Comandas)
// ─────────────────────────────────────────────

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  identifier   String
  capacity     Int?
  status       TableStatus @default(AVAILABLE)
  isActive     Boolean     @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tabs       Tab[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, identifier])
  @@index([restaurantId, status, isActive])
  @@map("tables")
}

enum TabStatus {
  OPEN
  CLOSED
  PAID
  CANCELLED
}

model Tab {
  id           String    @id @default(cuid())
  restaurantId String
  tableId      String?
  customerId   String?
  guestCustomerName String? // Cliente avulso (não salvo em customers)
  openedBy     String
  closedBy     String?

  status       TabStatus      @default(OPEN)
  total        Decimal        @db.Decimal(10, 2) @default(0)
  discount     Decimal        @db.Decimal(10, 2) @default(0)
  serviceCharge Decimal       @db.Decimal(10, 2) @default(0)  // Taxa de serviço (10%)
  coverCharge   Decimal       @db.Decimal(10, 2) @default(0)  // Couvert artístico
  finalTotal   Decimal        @db.Decimal(10, 2) @default(0)

  paymentMethod PaymentMethod?
  paidAt        DateTime?
  notes         String?

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        Table?      @relation(fields: [tableId], references: [id])
  customer     Customer?   @relation(fields: [customerId], references: [id])
  openedByUser User        @relation("TabsOpened", fields: [openedBy], references: [id])
  closedByUser User?       @relation("TabsClosed", fields: [closedBy], references: [id])
  orders       Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([restaurantId, status, createdAt(sort: Desc)])
  @@index([restaurantId, tableId, status])
  @@index([restaurantId, customerId, status])
  @@map("tabs")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum OrderStatus {
  NOVO_PEDIDO
  AGUARDANDO_CONFIRMACAO
  CONFIRMADO
  EM_PREPARO
  PRONTO
  SAIU_PARA_ENTREGA
  FINALIZADO
  CANCELADO
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  VOUCHER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id           String        @id @default(cuid())
  restaurantId String
  orderNumber  Int
  tabId        String?
  customerId   String?
  waiterId     String?
  tableNumber  String?
  type         OrderType     @default(DINE_IN)
  status       OrderStatus   @default(NOVO_PEDIDO)

  subtotal      Decimal @db.Decimal(10, 2)
  discount      Decimal @db.Decimal(10, 2) @default(0)
  deliveryFee   Decimal @db.Decimal(10, 2) @default(0)
  total         Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(PENDING)

  notes           String?
  deliveryAddress Json?
  couponId        String?

  // Printing
  printedAt      DateTime?
  printConfirmed Boolean   @default(false)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tab        Tab?        @relation(fields: [tabId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  waiter     User?       @relation("WaiterOrders", fields: [waiterId], references: [id])
  coupon     Coupon?     @relation(fields: [couponId], references: [id])
  items      OrderItem[]
  nps        NpsResponse[]
  financeEntries  FinanceEntry[]
  cashTransactions CashTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status, createdAt(sort: Desc)])
  @@index([restaurantId, printConfirmed])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  notes     String?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  addons  OrderItemAddon[]
  selectedOptions OrderItemSelectedOption[]
  splits          OrderItemSplit[]

  createdAt DateTime @default(now())

  @@map("order_items")
}

model OrderItemAddon {
  id          String  @id @default(cuid())
  orderItemId String
  addonId     String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)

  orderItem OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon     ProductAddon @relation(fields: [addonId], references: [id])

  @@map("order_item_addons")
}

model OrderItemSelectedOption {
  id               String  @id @default(cuid())
  orderItemId      String
  optionId         String
  quantity         Int     @default(1)
  unitPrice        Decimal @db.Decimal(10, 2)
  optionName       String
  isRemoval        Boolean @default(false)

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    ModifierOption  @relation(fields: [optionId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@map("order_item_selected_options")
}

model OrderItemSplit {
  id          String  @id @default(cuid())
  orderItemId String
  splitIndex  Int
  productId    String
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([orderItemId, splitIndex])
  @@index([orderItemId])
  @@map("order_item_splits")
}

// ─────────────────────────────────────────────
// CUSTOMERS (CRM)
// ─────────────────────────────────────────────

model Customer {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  phone        String?
  email        String?
  address      Json?
  notes        String?
  source       String? // Source of customer creation: DIGITAL_MENU, MANUAL, POS, etc.
  totalOrders  Int     @default(0)
  totalSpent   Decimal @db.Decimal(10, 2) @default(0)
  tabs         Tab[]
  
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]
  npsResponses NpsResponse[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([restaurantId, phone])
  @@map("customers")
}

// ─────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model InventoryItem {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  unit         String  // kg, L, un, etc.
  currentStock Decimal @db.Decimal(10, 3) @default(0)
  minimumStock Decimal @db.Decimal(10, 3) @default(0)
  averageCost  Decimal @db.Decimal(10, 2) @default(0)

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  movements  InventoryMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([restaurantId, deletedAt])
  @@map("inventory_items")
}

model InventoryMovement {
  id           String       @id @default(cuid())
  restaurantId String
  itemId       String
  type         MovementType
  quantity     Decimal      @db.Decimal(10, 3)
  unitCost     Decimal      @db.Decimal(10, 2) @default(0)
  reason       String?
  orderId      String?
  userId       String

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  item       InventoryItem @relation(fields: [itemId], references: [id])

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

// ─────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────

enum EntryType {
  REVENUE
  EXPENSE
}

model FinanceEntry {
  id            String        @id @default(cuid())
  restaurantId  String
  type          EntryType
  category      String
  description   String
  amount        Decimal       @db.Decimal(10, 2)
  date          DateTime      @db.Date
  paymentMethod PaymentMethod?
  orderId       String?
  userId        String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, date(sort: Desc)])
  @@map("finance_entries")
}

// ─────────────────────────────────────────────
// OPERATIONS
// ─────────────────────────────────────────────

model OperatingHours {
  id           String  @id @default(cuid())
  restaurantId String
  dayOfWeek    Int     // 0=Sun, 6=Sat
  openTime     String  // HH:MM
  closeTime    String  // HH:MM
  isClosed     Boolean @default(false)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@map("operating_hours")
}

model DeliveryZone {
  id                 String  @id @default(cuid())
  restaurantId       String
  name               String
  fee                Decimal @db.Decimal(10, 2) @default(0)
  estimatedMinutes   Int     @default(30)
  isActive           Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("delivery_zones")
}

model Coupon {
  id               String  @id @default(cuid())
  restaurantId     String
  code             String
  type             String  // PERCENTAGE | FIXED_AMOUNT
  value            Decimal @db.Decimal(10, 2)
  minOrderValue    Decimal @db.Decimal(10, 2) @default(0)
  maxUses          Int?
  usedCount        Int     @default(0)
  isFirstOrderOnly Boolean @default(false)
  expiresAt        DateTime?
  isActive         Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, code])
  @@map("coupons")
}

// ─────────────────────────────────────────────
// NPS
// ─────────────────────────────────────────────

model NpsResponse {
  id           String  @id @default(cuid())
  restaurantId String
  orderId      String
  customerId   String?
  score        Int     // 0-10
  comment      String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  @@map("nps_responses")
}

// ─────────────────────────────────────────────
// CASH REGISTER (Sistema de Caixa)
// ─────────────────────────────────────────────

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  SALE        // Venda (entrada)
  WITHDRAWAL  // Sangria (saída)
  SUPPLY      // Suprimento (entrada)
}

model CashRegister {
  id            String             @id @default(cuid())
  restaurantId  String
  userId        String
  status        CashRegisterStatus @default(OPEN)
  
  // Abertura
  openedAt      DateTime           @default(now())
  initialAmount Decimal            @db.Decimal(10, 2) // Valor inicial declarado
  openNotes     String?
  
  // Fechamento
  closedAt      DateTime?
  closedBy      String?
  
  // Valores declarados no fechamento (pelo operador)
  declaredCash    Decimal? @db.Decimal(10, 2)
  declaredDebit   Decimal? @db.Decimal(10, 2)
  declaredCredit  Decimal? @db.Decimal(10, 2)
  declaredPix     Decimal? @db.Decimal(10, 2)
  
  // Valores calculados pelo sistema
  expectedCash    Decimal? @db.Decimal(10, 2)
  expectedDebit   Decimal? @db.Decimal(10, 2)
  expectedCredit  Decimal? @db.Decimal(10, 2)
  expectedPix     Decimal? @db.Decimal(10, 2)
  
  // Diferenças (quebra de caixa)
  cashDifference   Decimal? @db.Decimal(10, 2)
  debitDifference  Decimal? @db.Decimal(10, 2)
  creditDifference Decimal? @db.Decimal(10, 2)
  pixDifference    Decimal? @db.Decimal(10, 2)
  
  closeNotes String?
  
  // Relations
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  openedBy     User              @relation("CashRegisterOpenedBy", fields: [userId], references: [id])
  closedByUser User?             @relation("CashRegisterClosedBy", fields: [closedBy], references: [id])
  transactions CashTransaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([restaurantId, status])
  @@index([restaurantId, openedAt])
  @@map("cash_registers")
}

model CashTransaction {
  id            String              @id @default(cuid())
  registerId    String
  type          CashTransactionType
  amount        Decimal             @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  description   String?
  orderId       String?
  userId        String?
  
  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  order    Order?        @relation(fields: [orderId], references: [id])
  user     User?         @relation("CashTransactionUser", fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  
  @@index([registerId, type])
  @@index([registerId, createdAt])
  @@map("cash_transactions")
}
